# Residuality Environment Configuration
# Copy to .env and fill in values

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
RESIDUALITY_PORT=5010
RESIDUALITY_USERNAME=admin
RESIDUALITY_PASSWORD=changeme

# External services
OWUI_URL=http://192.168.0.100:8282
OWUI_API_KEY=your-owui-api-key-here
QDRANT_URL=http://192.168.0.100:6333
EMBED_URL=http://192.168.0.100:8090

# Storage
REPOS_PATH=/repos

# Qdrant — collections are per-project: {PREFIX}_{project_id}_commits/graph/snapshots
QDRANT_COLLECTION_PREFIX=res

# Git identity
GIT_USER_NAME=Residuality
GIT_USER_EMAIL=residuality@local

# Model IDs (must match Open WebUI preset IDs)
# These are DEFAULTS. The homepage settings panel writes residuality_models.cfg
# into REPOS_PATH, and anything set there overrides these.
OWUI_MODEL=semantic-router
SUMMARIZER_MODEL=bonsai

# Largest edit range sent to a model, in characters. A local model's context is
# what this protects; the server reports back when it clamps.
MAX_EDIT_NODE_CHARS=6000

# Optional: GitHub/GitLab remote support
# GITHUB_TOKEN=your-token-here
