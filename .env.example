# Residuality Environment Configuration
# Copy to .env and fill in values

# Flask
FLASK_SECRET_KEY=change-me-to-a-random-string
RESIDUALITY_PORT=5010
RESIDUALITY_USERNAME=admin
RESIDUALITY_PASSWORD=changeme

# Reverse proxy (Nginx Proxy Manager, Traefik, Caddy...)
#
# TRUST_PROXY makes the app believe the X-Forwarded-Proto/-Host headers the
# proxy sets, so it knows it is on HTTPS and at the public name. Leave it true
# whenever something terminates TLS in front; set it false only if the app is
# reached directly, because those headers are client-settable.
TRUST_PROXY=true

# Marks the session cookie Secure, so the browser only sends it over HTTPS.
# Leave false while you also sign in over plain http://host:5010 locally;
# set it true once the public name is the only way in.
SESSION_COOKIE_SECURE=false

# External services
OWUI_URL=http://192.168.0.100:8282
OWUI_API_KEY=your-owui-api-key-here
QDRANT_URL=http://192.168.0.100:6333
# Embeddings are served by Open WebUI itself (/api/v1/embeddings), not a separate
# service. This defaults to OWUI_URL; set it only if you run a standalone embed
# server.
EMBED_URL=http://192.168.0.100:8282

# The embedding model every embeddings request names, e.g. nomic-embed-text or
# /models/Qwen3-Embedding-0.6B-Q8_0.gguf. Leave it blank only if the endpoint has
# a *default* embedding model configured: a request that names no model gets a
# bare 500 from an Open WebUI that has none, and no snapshot can be stored. The
# settings panel (Embedding model) overrides this.
EMBED_MODEL=

# The request path — the one thing the two servers disagree about. llama.cpp
# serves /v1/embeddings where Open WebUI serves /api/v1/embeddings, so set this
# only if EMBED_URL is not Open WebUI. The settings panel (Embedding path)
# overrides it, so this is just what a fresh install starts from.
# EMBED_PATH=/v1/embeddings

# Only if that server wants its own key; otherwise the OWUI key is reused.
# EMBED_API_KEY=

# Storage
REPOS_PATH=/repos

# Qdrant — collections are per-project: {PREFIX}_{project_id}_commits/graph/snapshots
QDRANT_COLLECTION_PREFIX=res

# Git identity
GIT_USER_NAME=Residuality
GIT_USER_EMAIL=residuality@local

# Model IDs (must match Open WebUI preset IDs)
# These are DEFAULTS. The homepage settings panel writes residuality_models.cfg
# into REPOS_PATH, and anything set there overrides these.
OWUI_MODEL=semantic-router
SUMMARIZER_MODEL=bonsai

# The model's context window, in tokens. One AI edit may send about half of it,
# in characters, because the replacement comes back roughly as long as the range
# it replaces and both have to fit at once. A range larger than that budget is
# split on the graph's node boundaries and sent as several calls, so this is a
# per-call ceiling, not a cap on how much can be edited. The homepage settings
# panel can change this.
OWUI_CONTEXT_TOKENS=262144

# Optional hard override for the above, in characters. Leave it blank to derive
# the budget from the window; 0 means no limit.
# MAX_EDIT_NODE_CHARS=524288

# Optional: GitHub/GitLab remote support
# GITHUB_TOKEN=your-token-here
